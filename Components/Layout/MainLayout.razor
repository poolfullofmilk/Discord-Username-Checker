@inherits LayoutComponentBase

@* MudThemeProvider *@
<MudThemeProvider Theme="ApplicationTheme"
                  IsDarkMode="true" />

@* MudLayout *@
<MudLayout>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Small"
                      Class="my-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@* MudElement *@
<MudElement HtmlTag="div"
            id="blazor-error-ui"
            data-nosnippet
            Style="color-scheme: light only; background: lightyellow; color: #000; bottom: 0; box-shadow: 0 -1px 2px rgba(0, 0, 0, 0.2); box-sizing: border-box; display: none; left: 0; padding: 0.6rem 1.25rem 0.7rem 1.25rem; position: fixed; width: 100%; z-index: 1000">
    An Unhandled Error Has Occurred
    <MudLink Href="."
             Class="reload">
        Reload
    </MudLink>
    <MudElement HtmlTag="span"
                Class="dismiss"
                Style="cursor: pointer; position: absolute; right: 0.75rem; top: 0.5rem">
        🗙
    </MudElement>
</MudElement>
